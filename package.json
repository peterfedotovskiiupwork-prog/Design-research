{
  "name": "design-research-trigger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npx trigger.dev@latest dev\" \"tsx watch src/server/index.ts\"",
    "dev:trigger": "npx trigger.dev@latest dev",
    "dev:server": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@trigger.dev/build": "4.4.6",
    "@trigger.dev/sdk": "4.4.6",
    "express": "^4.21.0",
    "nodemailer": "^6.9.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.7.284",
    "puppeteer": "^24.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
